# Where the Laravel API runs. Only the Next.js server uses it; browsers never see it.
API_URL=http://127.0.0.1:8000

# Proves to the API that requests come through the web app (ADR-025). A long random text, the SAME
# value as WEB_PROXY_SECRET in apps/api/.env. Server-side only (no NEXT_PUBLIC_), never sent to browsers.
WEB_PROXY_SECRET=

# Error alerts (docs/deploy.md): the DSN of the Next.js project in Sentry. Public on purpose (browsers send
# errors to it). Empty = nothing is sent.
NEXT_PUBLIC_SENTRY_DSN=
