APP_NAME=CourtKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courtku
DB_USERNAME=courtku
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Booking emails wait here until the minute tick sends them (ADR-027): run `php artisan schedule:work`.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@courtku.test"
MAIL_FROM_NAME="${APP_NAME}"

# Venue photos (ADR-018): Cloudinary → Settings → API Keys. Leave empty to turn uploads off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=courtku-local

# The every-minute jobs (ADR-022). A long random text; the cron service sends it as the X-Cron-Secret header
# to POST /api/tick. Leave empty locally and run `php artisan schedule:work` instead.
CRON_SECRET=

# The web app proves it is the web app with this (ADR-025): a long random text, the SAME value as
# WEB_PROXY_SECRET in apps/web/.env.local. Empty = the API believes forwarded headers from anyone.
WEB_PROXY_SECRET=

# Error alerts (docs/deploy.md): the DSN of the Laravel project in Sentry. Empty = nothing is sent.
SENTRY_LARAVEL_DSN=

# The demo world (ADR-030): 20 made-up venues full of bookings, kept fresh by the minute tick.
# true on the live site; locally, run `php artisan courtku:demo --until-done` once after switching it on.
DEMO_WORLD=false
# The Stripe test account (acct_...) the online demo venue uses; empty = demo venues are pay-at-venue only.
DEMO_STRIPE_ACCOUNT_ID=

# Stripe test mode (ADR-023): Stripe dashboard (Sandbox) → Developers → API keys → Secret key (sk_test_...).
# CourtKu's own platform key, with Connect turned on. Venues connect their accounts through Stripe Connect (ADR-024).
STRIPE_SECRET_KEY=
# The Connect webhook's signing secret (whsec_...). Stripe can't reach a laptop, so it can stay empty locally.
STRIPE_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
FRONTEND_URL=http://localhost:3000
APP_TIMEZONE=UTC
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
