# Settings for the browser tests (apps/web/e2e, ADR-034). apps/web/e2e/start-api.mjs copies this to
# .env.e2e (not in git), fills in APP_KEY and the DB_* values it was given, and starts the API with
# APP_ENV=e2e on port 8100 for the web app on port 3100. Its own database, so local data is never touched.
APP_NAME=CourtKu
APP_ENV=e2e
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3100
FRONTEND_URL=http://localhost:3100
SANCTUM_STATEFUL_DOMAINS=localhost:3100,127.0.0.1:3100
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courtku_e2e
DB_USERNAME=courtku
DB_PASSWORD=secret

# No Redis needed: everything in MySQL, and emails go out straight away instead of by the minute tick.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mailpit (docker compose locally, a service container in CI): the tests read the verify link from it.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@courtku.test"
MAIL_FROM_NAME="${APP_NAME}"

# The pretend Stripe page instead of Stripe (ADR-034).
PAYMENT_GATEWAY=pretend

# A test value; the same one is given to the web app by playwright.config.ts.
WEB_PROXY_SECRET=e2e-web-proxy-secret

DEMO_WORLD=false
CRON_SECRET=
SENTRY_LARAVEL_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=courtku-e2e
